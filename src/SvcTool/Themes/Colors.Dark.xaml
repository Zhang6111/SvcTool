<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        深色主题的颜色。

        与 Colors.Light.xaml 的键完全一一对应，改动时两边都要改。
        说明见 Colors.xaml。
    -->

    <!-- 基础界面 -->
    <SolidColorBrush x:Key="App.Surface"       Color="#2B2B2B" />
    <SolidColorBrush x:Key="App.SurfaceAlt"    Color="#262626" />
    <SolidColorBrush x:Key="App.Border"        Color="#3A3A3A" />
    <SolidColorBrush x:Key="App.BorderStrong"  Color="#4A4A4A" />
    <SolidColorBrush x:Key="App.Text"          Color="#F2F2F2" />
    <SolidColorBrush x:Key="App.TextSecondary" Color="#C5C5C5" />
    <SolidColorBrush x:Key="App.TextTertiary"  Color="#9A9A9A" />

    <!-- 深色主题的强调色偏亮，用深色文字才看得清 -->
    <SolidColorBrush x:Key="App.TextOnAccent"  Color="#003350" />

    <SolidColorBrush x:Key="App.Hover"         Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="App.Pressed"       Color="#17FFFFFF" />
    <SolidColorBrush x:Key="App.Selected"      Color="#12FFFFFF" />

    <!-- 服务状态色：深色背景上要用更亮、更柔和的色，否则刺眼且对比不足 -->
    <SolidColorBrush x:Key="App.StatusRunning" Color="#6CCB5F" />
    <SolidColorBrush x:Key="App.StatusStopped" Color="#9A9A9A" />
    <SolidColorBrush x:Key="App.StatusPending" Color="#FCE100" />
    <SolidColorBrush x:Key="App.StatusPaused"  Color="#6CB8F6" />
    <SolidColorBrush x:Key="App.StatusFailed"  Color="#FF99A4" />

    <SolidColorBrush x:Key="App.Success"       Color="#6CCB5F" />
    <SolidColorBrush x:Key="App.Warning"       Color="#FCE100" />
    <SolidColorBrush x:Key="App.Error"         Color="#FF99A4" />
    <SolidColorBrush x:Key="App.Info"          Color="#4CC2FF" />

    <SolidColorBrush x:Key="App.CategoryDriver" Color="#B98AE0" />
    <SolidColorBrush x:Key="App.CategorySystem" Color="#9AA4B2" />
    <SolidColorBrush x:Key="App.CategoryUser"   Color="#4FC7C5" />

    <!-- 深色主题下底色需要更实一些，否则在深背景上看不出来 -->
    <SolidColorBrush x:Key="App.CategoryDriverSoft" Color="#38B98AE0" />
    <SolidColorBrush x:Key="App.CategorySystemSoft" Color="#389AA4B2" />
    <SolidColorBrush x:Key="App.CategoryUserSoft"   Color="#384FC7C5" />

    <SolidColorBrush x:Key="App.SuccessSoft"   Color="#206CCB5F" />
    <SolidColorBrush x:Key="App.WarningSoft"   Color="#20FCE100" />
    <SolidColorBrush x:Key="App.ErrorSoft"     Color="#20FF99A4" />
    <SolidColorBrush x:Key="App.InfoSoft"      Color="#204CC2FF" />
    <SolidColorBrush x:Key="App.SuccessBorder" Color="#666CCB5F" />
    <SolidColorBrush x:Key="App.WarningBorder" Color="#66FCE100" />
    <SolidColorBrush x:Key="App.ErrorBorder"   Color="#66FF99A4" />
    <SolidColorBrush x:Key="App.InfoBorder"    Color="#664CC2FF" />

</ResourceDictionary>
