<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        字体与字号定义。

        规则：界面里不允许写死 FontSize，一律引用这里的键。
        取值依据见 UI设计.md 第 3.3、3.4 节。
    -->

    <!-- ============================================================ -->
    <!-- 字体族                                                        -->
    <!-- ============================================================ -->

    <!--
        界面字体。

        西文优先 Segoe UI Variable（Windows 11 的系统字体），
        中文回退到微软雅黑 UI。WPF 会按顺序找第一个可用的字体，
        所以中英文能各用各的最佳字体。
    -->
    <FontFamily x:Key="App.FontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei, sans-serif</FontFamily>

    <!--
        等宽字体。

        用于服务名、程序路径、启动参数这类技术信息。
        路径里的空格、斜杠、层级在等宽字体下才能一眼看清，
        排查问题时这一点很重要。
    -->
    <FontFamily x:Key="App.MonoFontFamily">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- 图标字体，仅作为矢量图标之外的备用手段，见 Icons.xaml 的说明 -->
    <FontFamily x:Key="App.IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ============================================================ -->
    <!-- 字号阶梯                                                      -->
    <!-- ============================================================ -->

    <sys:Double x:Key="App.FontSize.PageTitle">20</sys:Double>
    <sys:Double x:Key="App.FontSize.SectionTitle">16</sys:Double>
    <sys:Double x:Key="App.FontSize.Body">14</sys:Double>
    <sys:Double x:Key="App.FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="App.FontSize.Mono">13</sys:Double>

    <!-- ============================================================ -->
    <!-- 间距                                                          -->
    <!-- ============================================================ -->
    <!--
        采用 4 的倍数，见 UI设计.md 第 3.5 节。
        用 Thickness 而非 Double，方便直接用在 Margin / Padding 上。
    -->

    <Thickness x:Key="App.Spacing.Tight">4</Thickness>
    <Thickness x:Key="App.Spacing.Small">8</Thickness>
    <Thickness x:Key="App.Spacing.Medium">12</Thickness>
    <Thickness x:Key="App.Spacing.Large">16</Thickness>
    <Thickness x:Key="App.Spacing.Page">20</Thickness>

    <sys:Double x:Key="App.CornerRadius.Small">4</sys:Double>
    <sys:Double x:Key="App.CornerRadius.Card">8</sys:Double>

    <!-- ============================================================ -->
    <!-- 文本样式                                                      -->
    <!-- ============================================================ -->

    <Style x:Key="App.Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource App.FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource App.FontSize.PageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="App.Text.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource App.FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource App.FontSize.SectionTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    </Style>

    <Style x:Key="App.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource App.FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource App.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    </Style>

    <Style x:Key="App.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource App.FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource App.FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextTertiary}" />
    </Style>

    <!--
        技术信息文本：等宽字体。

        用在服务名、程序路径、启动参数上。
        TextTrimming 让超长路径自动截断，完整内容通过 ToolTip 展示。
    -->
    <Style x:Key="App.Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource App.MonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource App.FontSize.Mono}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

</ResourceDictionary>
