<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        控件样式。

        规则：界面里不写死颜色、字号、圆角，一律引用 Colors.xaml / Typography.xaml 里的键。
        想整体换配色时，只改 Colors.xaml 一个文件。

        说明见 UI设计.md 第 3 节。
    -->

    <!-- ================================================================ -->
    <!-- 按钮                                                             -->
    <!-- ================================================================ -->

    <!--
        按钮基础样式：描边风格（次要按钮）。

        模板里叠了两层 Border：
          Bd      —— 负责背景和边框，由 Button 的 Background / BorderBrush 控制
          Overlay —— 只负责鼠标悬停和按下的反馈，默认透明

        之所以要分开，是因为悬停色是半透明的。如果直接改 Bd 的背景，
        按钮原本的底色就被"抹掉"了，看起来会变透明。
    -->
    <Style x:Key="App.Button" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource App.FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource App.FontSize.Body}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" />
                        <Border x:Name="Overlay"
                                Background="Transparent"
                                CornerRadius="4" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource App.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource App.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        主按钮：实心强调色。

        强调色取自 Windows 系统设置，用户改主题色界面会跟着变。
        注意文字用 App.TextOnAccent 而不是 App.Text，否则深色强调色上会看不清。
    -->
    <Style x:Key="App.Button.Primary" TargetType="Button" BasedOn="{StaticResource App.Button}">
        <Setter Property="Background" Value="{DynamicResource App.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextOnAccent}" />
    </Style>

    <!--
        危险按钮：删除等不可逆操作。

        平时只把文字标红，鼠标悬停才铺红色底 —— 视觉上有分量，
        但不至于在工具栏里一直"喊叫"。
    -->
    <Style x:Key="App.Button.Danger" TargetType="Button" BasedOn="{StaticResource App.Button}">
        <Setter Property="Foreground" Value="{DynamicResource App.Error}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.BorderStrong}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" />
                        <Border x:Name="Overlay"
                                Background="Transparent"
                                CornerRadius="4" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource App.ErrorSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Error}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource App.ErrorBorder}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 纯图标按钮：正方形、无边框，用于刷新、关闭、行内快捷操作 -->
    <Style x:Key="App.Button.Icon" TargetType="Button" BasedOn="{StaticResource App.Button}">
        <Setter Property="Width" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
    </Style>

    <!-- ================================================================ -->
    <!-- 输入框                                                           -->
    <!-- ================================================================ -->

    <!--
        文本框样式。

        焦点态用强调色描边加一圈淡光晕，与 Windows 11 的输入框一致，
        用户能一眼看出焦点在哪。
    -->
    <Style x:Key="App.TextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource App.FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource App.FontSize.Body}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource App.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ -->
    <!-- 卡片                                                             -->
    <!-- ================================================================ -->

    <!--
        卡片：详情页里每个信息分组一个。

        刻意不加阴影和粗边框，靠留白和背景色区分层次，避免线条过多。
    -->
    <Style x:Key="App.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 卡片内的分组标题 -->
    <Style x:Key="App.Card.Header" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource App.FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource App.FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
    </Style>

    <!-- ================================================================ -->
    <!-- 状态文字                                                         -->
    <!-- ================================================================ -->

    <!--
        服务状态文字的颜色。

        状态用"颜色 + 文字"双重表达，不单靠颜色 —— 见 UI设计.md 第 2 节的原则三。
        这里只负责颜色，文字由绑定提供。

        用 DataTrigger 比对枚举值而不是写值转换器：XAML 会自动把字符串
        转成对应的枚举成员，省掉一个类。
    -->
    <Style x:Key="App.Text.Status" TargetType="TextBlock" BasedOn="{StaticResource App.Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource App.FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextTertiary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Running">
                <Setter Property="Foreground" Value="{DynamicResource App.StatusRunning}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Stopped">
                <Setter Property="Foreground" Value="{DynamicResource App.StatusStopped}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Paused">
                <Setter Property="Foreground" Value="{DynamicResource App.StatusPaused}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="StartPending">
                <Setter Property="Foreground" Value="{DynamicResource App.StatusPending}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="StopPending">
                <Setter Property="Foreground" Value="{DynamicResource App.StatusPending}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================ -->
    <!-- 分类徽章                                                         -->
    <!-- ================================================================ -->

    <!--
        徽章的基础样式。

        用 ContentControl 而不是 Border，是为了让底色和文字色成对定义，
        使用时只需一个 Style，不用再给里面的文字单独指定颜色。

        用法：<ContentControl Style="{StaticResource App.Badge.User}" Content="自建" />
    -->
    <Style x:Key="App.Badge" TargetType="ContentControl">
        <Setter Property="FontFamily" Value="{StaticResource App.FontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="8,0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.Badge.Driver" TargetType="ContentControl" BasedOn="{StaticResource App.Badge}">
        <Setter Property="Background" Value="{DynamicResource App.CategoryDriverSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource App.CategoryDriver}" />
    </Style>

    <Style x:Key="App.Badge.System" TargetType="ContentControl" BasedOn="{StaticResource App.Badge}">
        <Setter Property="Background" Value="{DynamicResource App.CategorySystemSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource App.CategorySystem}" />
    </Style>

    <Style x:Key="App.Badge.User" TargetType="ContentControl" BasedOn="{StaticResource App.Badge}">
        <Setter Property="Background" Value="{DynamicResource App.CategoryUserSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource App.CategoryUser}" />
    </Style>

</ResourceDictionary>
