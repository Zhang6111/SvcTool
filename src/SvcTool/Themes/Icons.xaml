<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        矢量图标。

        ============================ 重要约束 ============================
        本项目禁止使用 emoji 作为图标。所有图标一律在这里以矢量图形
        （Geometry）定义，理由：
          1. emoji 的渲染依赖系统字体，不同 Windows 版本长相差异很大
          2. emoji 无法跟随主题色变化
          3. emoji 无法精确控制尺寸、线宽、对齐
        界面里也不要出现任何来自 "Segoe UI Emoji" 的字符。

        ============================ 命名约定 ============================
        资源键名与 UI设计.md 第 4 节的清单、prototype/index.html 中的
        SVG symbol id 三者保持一致，方便互相对照。

        ============================ 使用方式 ============================
        描边类图标（线条图形）：
            <Path Style="{StaticResource App.Icon}"
                  Data="{StaticResource Icon.Play}" />

        填充类图标（实心图形）：
            <Path Style="{StaticResource App.Icon.Solid}"
                  Data="{StaticResource Icon.Star}" />

        图标颜色继承自所在父级控件的 Foreground（见下方样式的说明）。
        需要单独指定颜色时，在使用的那个 Path 上直接写 Fill / Stroke 覆盖。
    -->

    <!-- ================================================================ -->
    <!-- 描边类图标                                                       -->
    <!-- ================================================================ -->

    <!-- 搜索：放大镜 -->
    <GeometryGroup x:Key="Icon.Search">
        <EllipseGeometry Center="7,7" RadiusX="4.25" RadiusY="4.25" />
        <LineGeometry StartPoint="10.3,10.3" EndPoint="14,14" />
    </GeometryGroup>

    <!-- 刷新：两个首尾相接的箭头 -->
    <PathGeometry x:Key="Icon.Refresh"
                  Figures="M3.2,6.5 A5.2,5.2 0 0 1 12,5.1
                           M12.8,9.5 A5.2,5.2 0 0 1 4,10.9
                           M12.3,2.3 L12.3,5.2 L9.4,5.2
                           M3.7,13.7 L3.7,10.8 L6.6,10.8" />

    <!-- 新增：加号 -->
    <PathGeometry x:Key="Icon.Plus" Figures="M8,3 L8,13 M3,8 L13,8" />

    <!-- 重启：环形箭头 -->
    <GeometryGroup x:Key="Icon.Restart">
        <PathGeometry Figures="M12.6,5.5 A5.2,5.2 0 1 0 13.2,8" />
        <PathGeometry Figures="M13.4,2.5 L13.4,5.7 L10.2,5.7" />
    </GeometryGroup>

    <!-- 修改：铅笔 -->
    <PathGeometry x:Key="Icon.Edit"
                  Figures="M11.1,2.9 A1.55,1.55 0 0 1 13.3,5.1
                           L5.5,12.9 L2.2,13.4 L2.7,10.1 Z" />

    <!-- 删除：垃圾桶 -->
    <PathGeometry x:Key="Icon.Delete"
                  Figures="M2.9,4.3 L13.1,4.3
                           M6.1,4.3 L6.1,3.2 A1,1 0 0 1 7.1,2.2 L8.9,2.2 A1,1 0 0 1 9.9,3.2 L9.9,4.3
                           M4.3,4.3 L5,12.5 A1.1,1.1 0 0 0 6.1,13.5 L9.9,13.5 A1.1,1.1 0 0 0 11,12.5 L11.7,4.3" />

    <!-- 复制：两个叠放的圆角方框 -->
    <GeometryGroup x:Key="Icon.Copy">
        <RectangleGeometry Rect="2.8,2.8,7.2,7.2" RadiusX="1.4" RadiusY="1.4" />
        <RectangleGeometry Rect="6,6,7.2,7.2" RadiusX="1.4" RadiusY="1.4" />
    </GeometryGroup>

    <!-- 打开所在位置：文件夹 -->
    <PathGeometry x:Key="Icon.Folder"
                  Figures="M2,12.6 L2,4.1 A1,1 0 0 1 3,3.1 L6.1,3.1 L7.5,4.8 L13,4.8
                           A1,1 0 0 1 14,5.8 L14,12.6 A1,1 0 0 1 13,13.6 L3,13.6 A1,1 0 0 1 2,12.6 Z" />

    <!-- 状态：已停止（空心圆） -->
    <EllipseGeometry x:Key="Icon.StatusStopped" Center="8,8" RadiusX="4.6" RadiusY="4.6" />

    <!--
        状态：进行中（约 300 度的圆弧）。

        用圆弧而非半实心圆，是为了让它只依赖描边、能和其它状态图标
        共用同一套样式。配合圆角线帽，看起来就是一个加载指示环。
    -->
    <PathGeometry x:Key="Icon.StatusPending"
                  Figures="M8,3.4 A4.6,4.6 0 1 1 4.75,12.35" />

    <!-- 警告：三角形加感叹号（感叹号下半段用极短线段渲染成圆点） -->
    <PathGeometry x:Key="Icon.Warning"
                  Figures="M8,2.3 L14.7,13.6 L1.3,13.6 Z
                           M8,6.4 L8,9.5
                           M8,11.5 L8,11.51" />

    <!-- 错误：圆形加叉 -->
    <GeometryGroup x:Key="Icon.Error">
        <EllipseGeometry Center="8,8" RadiusX="6" RadiusY="6" />
        <LineGeometry StartPoint="5.9,5.9" EndPoint="10.1,10.1" />
        <LineGeometry StartPoint="10.1,5.9" EndPoint="5.9,10.1" />
    </GeometryGroup>

    <!-- 成功：圆形加对勾 -->
    <GeometryGroup x:Key="Icon.Success">
        <EllipseGeometry Center="8,8" RadiusX="6" RadiusY="6" />
        <PathGeometry Figures="M5.3,8.2 L7.3,10.2 L10.8,6.1" />
    </GeometryGroup>

    <!-- 提示：圆形加 i -->
    <GeometryGroup x:Key="Icon.Info">
        <EllipseGeometry Center="8,8" RadiusX="6" RadiusY="6" />
        <LineGeometry StartPoint="8,7.3" EndPoint="8,11.2" />
        <LineGeometry StartPoint="8,5" EndPoint="8,5.01" />
    </GeometryGroup>

    <!-- 对勾（用于向导步骤完成标记、签名有效标记） -->
    <PathGeometry x:Key="Icon.Check" Figures="M3,8.5 L6.4,11.9 L13,5.3" />

    <!-- 向导：下一步 / 上一步 -->
    <PathGeometry x:Key="Icon.ChevronRight" Figures="M6,3.6 L10.4,8 L6,12.4" />
    <PathGeometry x:Key="Icon.ChevronLeft" Figures="M10,3.6 L5.6,8 L10,12.4" />

    <!-- 关闭 / 清除 -->
    <PathGeometry x:Key="Icon.Close" Figures="M4.2,4.2 L11.8,11.8 M11.8,4.2 L4.2,11.8" />

    <!-- 列排序指示：上下双三角 -->
    <PathGeometry x:Key="Icon.Sort" Figures="M5,6.4 L8,3.4 L11,6.4 M5,9.6 L8,12.6 L11,9.6" />

    <!-- ================================================================ -->
    <!-- 填充类图标                                                       -->
    <!-- ================================================================ -->

    <!-- 启动：实心三角 -->
    <PathGeometry x:Key="Icon.Play" Figures="M5.2,3.6 L12.4,8 L5.2,12.4 Z" />

    <!-- 停止：实心圆角方块 -->
    <RectangleGeometry x:Key="Icon.Stop" Rect="4.2,4.2,7.6,7.6" RadiusX="1.6" RadiusY="1.6" />

    <!-- 状态：运行中（实心圆） -->
    <EllipseGeometry x:Key="Icon.StatusRunning" Center="8,8" RadiusX="4.6" RadiusY="4.6" />

    <!-- 状态：已暂停（双竖条） -->
    <GeometryGroup x:Key="Icon.StatusPaused">
        <RectangleGeometry Rect="5.1,4.2,1.9,7.6" RadiusX="0.7" RadiusY="0.7" />
        <RectangleGeometry Rect="9,4.2,1.9,7.6" RadiusX="0.7" RadiusY="0.7" />
    </GeometryGroup>

    <!-- 本工具创建标记：实心五角星 -->
    <PathGeometry x:Key="Icon.Star"
                  Figures="M8,1.9 L9.85,5.8 L14.1,6.4 L11,9.4 L11.75,13.55
                           L8,11.5 L4.25,13.55 L5,9.4 L1.9,6.4 L6.15,5.8 Z" />

    <!-- ================================================================ -->
    <!-- 图标样式                                                         -->
    <!-- ================================================================ -->

    <!--
        描边类图标的基础样式。

        颜色方面：绑定的目标是 Path 自己身上的 TextElement.Foreground。
        TextElement.Foreground 是一个可继承的附加属性，会从父级控件
        （按钮、列表项等）继承下来。所以把图标放进一个设置了 Foreground
        的控件里，图标就会自动取该颜色，并且能跟随主题变化。

        如果需要固定颜色，在使用处直接写 Fill / Stroke 覆盖即可。
    -->
    <Style x:Key="App.Icon" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Stroke"
                Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
    </Style>

    <!-- 填充类图标 -->
    <Style x:Key="App.Icon.Solid" TargetType="Path" BasedOn="{StaticResource App.Icon}">
        <Setter Property="Fill"
                Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
        <Setter Property="Stroke" Value="{x:Null}" />
    </Style>

    <!-- 小号图标，用于列表行内的紧凑位置 -->
    <Style x:Key="App.Icon.Small" TargetType="Path" BasedOn="{StaticResource App.Icon}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="StrokeThickness" Value="1.6" />
    </Style>

    <Style x:Key="App.Icon.Small.Solid" TargetType="Path" BasedOn="{StaticResource App.Icon.Solid}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <!-- 大号图标 -->
    <Style x:Key="App.Icon.Large" TargetType="Path" BasedOn="{StaticResource App.Icon}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

</ResourceDictionary>
