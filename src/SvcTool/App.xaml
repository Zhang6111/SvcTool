<Application x:Class="SvcTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System">

    <!--
        ThemeMode="System"

        这一行启用 .NET 内置的 Fluent 主题，跟随 Windows 的浅色/深色设置。
        自动获得：圆角控件、Windows 11 设计规范外观、系统强调色。
        这是零第三方依赖实现现代界面的关键，不要移除。

        注意：该 API 在 .NET 10 里仍标记为实验性（WPF0001），
        已在 SvcTool.csproj 里通过 NoWarn 屏蔽警告。

        下面合并的顺序有讲究：
          - Colors.xaml 提供与主题无关的键（强调色）
          - Colors.Light.xaml 是"主题槽"，运行时会被 ThemeManager 换成深色版本
          - Controls.xaml 会引用前面几个文件里定义的键，所以它必须排在最后

        没有设置 StartupUri：主窗口由 App.xaml.cs 的 OnStartup 手工创建，
        因为需要在那里把视图模型注入进去。见 设计文档.md 第 1.6 节。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
