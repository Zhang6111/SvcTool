<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SvcTool</RootNamespace>
    <AssemblyName>SvcTool</AssemblyName>

    <!-- 服务操作需要管理员权限，由 Windows 在启动时提示提权 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Application.ThemeMode / Window.ThemeMode 是 .NET 9 引入的 Fluent 主题入口，
      在 .NET 10 里仍标记为实验性（诊断代号 WPF0001）。我们要用的就是它，屏蔽该警告。
    -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SvcTool.Core\SvcTool.Core.csproj" />
  </ItemGroup>

</Project>
